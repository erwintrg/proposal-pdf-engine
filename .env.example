# Copy to .env and fill in only what you use. The demo needs none of it.

# Chromium used for HTML -> PDF. Empty = Playwright's bundled Chromium
# (python -m playwright install chromium). Example: /usr/bin/chromium
PROPOSAL_CHROMIUM=

# Default theme for render.py and draft.py (a folder name in themes/ or a path)
PROPOSAL_THEME=ycat

# draft.py --backend anthropic (or claude-cli, which uses your Claude Code login instead)
ANTHROPIC_API_KEY=
PROPOSAL_MODEL=claude-opus-5

# render.py --stripe: restricted key with write access to Products, Prices and Payment Links
STRIPE_API_KEY=

# render.py --drive: a service account file ...
GOOGLE_SERVICE_ACCOUNT_FILE=
# ... or an OAuth client with a refresh token (scope: drive.file)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Optional: put the Proposals folder inside a folder this tool created
DRIVE_PARENT_FOLDER_ID=
